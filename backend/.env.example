# =============================================
# EM Furniture & Interior — Backend Environment
# =============================================

# --- App ---
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/em_furniture

# --- Auth ---
JWT_SECRET=change_me_to_a_strong_random_string

# --- Cloudinary (image hosting) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Gmail OAuth2 (email sending) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=
EMAIL_USER=emfurnitureandinterior@gmail.com

# --- Payment gateways ---
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=NGN

# --- Payment webhooks (REQUIRED in production) ---
# Without these the webhook endpoints return 500 and payment confirmation falls
# back to the browser callback, which loses any payment where the customer does
# not return to the site.
#
# Paystack   reuses PAYSTACK_SECRET_KEY to sign; register the endpoint at
#            Dashboard > Settings > API Keys & Webhooks:
#              https://<api-host>/api/payments/webhooks/paystack
# Stripe     signing secret (whsec_...) shown when you add the endpoint:
#              https://<api-host>/api/payments/webhooks/stripe
#            Subscribe to: checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# --- Pricing (server-authoritative) ---
# The server derives every money figure on an order from catalog prices and
# these values. Nothing about pricing is taken from the request body.
TAX_RATE_PERCENTAGE=7.5
# Flat shipping charge applied to every order. 0 = free shipping, which is the
# behaviour the checkout page has always shown.
SHIPPING_FLAT_RATE=0

# --- Seed (optional) ---
SEED_ADMIN_PASSWORD=ChangeMe123!
