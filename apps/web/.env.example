# Storefront (Vercel). Everything VITE_-prefixed is compiled into the bundle and
# is readable by any visitor — never put a secret here.

# Base URL of the API, including the /api prefix.
VITE_API_URL=http://localhost:5000/api

# Where the "Operations" link in the navbar sends staff.
VITE_ERP_URL=http://localhost:5174/admin/dashboard
