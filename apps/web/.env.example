# =======================================================
# Storefront (Vercel Deployment) — Environment Variables
# =======================================================
# Everything VITE_-prefixed is compiled into the static browser bundle and
# is readable by ANY visitor. NEVER put server secrets or private keys here.

# Base URL of the deployed API, including the /api prefix (no trailing slash).
# Local: http://localhost:5000/api
# Production: https://api.yourdomain.com/api or https://your-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Where the "Operations" link in the navbar directs staff members.
# Local: http://localhost:5174/admin/dashboard
# Production: https://erp.yourdomain.com/admin/dashboard or https://your-erp.vercel.app/admin/dashboard
VITE_ERP_URL=http://localhost:5174/admin/dashboard

# --- Google Maps (Optional) ---
# Used for the interactive Google Maps embed on the Showroom page (/showroom).
# Obtain from Google Cloud Console (Maps Embed API).
VITE_REACT_APP_GOOGLE_MAPS_API_KEY=

# --- Supabase Auth (Optional) ---
# Set both and a "Continue with Google" button appears on the sign-in page,
# which exchanges a Supabase token for the app's own session at POST /api/auth/supabase.
# Leave empty to disable.
#
# The anon key is safe for browser bundles. The service role key must NEVER be here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
