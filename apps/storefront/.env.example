# =============================================
# EM Furniture & Interior — Storefront (public)
# =============================================
#
# Copy to .env.local and fill in. .env* is gitignored except this file.
#
# EVERY VITE_-PREFIXED VALUE IS PUBLIC. Vite compiles them into the JavaScript
# bundle, so anyone who loads the site can read them. The Supabase anon key is
# designed for that and is safe here. The service-role key, gateway secrets and
# the backup key are NOT — they belong only in the API environment.

# API origin. Empty means same-origin '/api', which is correct while the API
# serves the built storefront. Once the apps move to Vercel and the API to
# Render this must be the full API URL, or every request 404s.
VITE_API_BASE_URL=

# --- Supabase [R2] ---
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Cloudinary (direct signed uploads) [R4] ---
VITE_CLOUDINARY_CLOUD_NAME=

# --- Observability [R4] ---
VITE_SENTRY_DSN=
