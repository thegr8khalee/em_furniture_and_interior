# Operations console (Vercel, restricted). Everything VITE_-prefixed is compiled
# into the bundle — never put a secret here.

VITE_API_URL=http://localhost:5000/api
VITE_STOREFRONT_URL=http://localhost:5173

# --- Supabase Auth (optional) ---
# Set both and a "Continue with Google" button appears on the sign-in page,
# which exchanges a Supabase token for the app's own session at
# POST /api/auth/supabase. Leave them unset and nothing is rendered and the
# Supabase SDK is never downloaded.
#
# The anon key is the only Supabase key that belongs in a browser bundle. The
# service role key bypasses Row Level Security and lives on the API host.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
