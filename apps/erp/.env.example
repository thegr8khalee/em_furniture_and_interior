# ==========================================================
# Operations Console ERP (Vercel) — Environment Variables
# ==========================================================
# Everything VITE_-prefixed is compiled into the static browser bundle.
# NEVER put server secrets or private keys here.

# Base URL of the deployed API, including the /api prefix (no trailing slash).
# Local: http://localhost:5000/api
# Production: https://api.yourdomain.com/api or https://your-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Public storefront URL linked in the ERP header ("View Storefront").
# Local: http://localhost:5173
# Production: https://yourdomain.com or https://your-storefront.vercel.app
VITE_STOREFRONT_URL=http://localhost:5173

# --- Supabase Auth (Optional) ---
# Set both to enable Google OAuth single sign-on for admin staff at
# POST /api/admin/supabase. Leave empty to use local staff credentials.
#
# The anon key is safe for browser bundles. The service role key must NEVER be here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
