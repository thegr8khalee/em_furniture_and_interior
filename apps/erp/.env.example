# =============================================
# EM Furniture & Interior — Operations Console
# =============================================
#
# Copy to .env.local and fill in. .env* is gitignored except this file.
#
# EVERY VITE_-PREFIXED VALUE IS PUBLIC — compiled into the bundle and readable
# by anyone who loads the console. Access control for this app is a deployment
# concern (Vercel Authentication or an IP allowlist), not something an
# environment variable can provide. The Supabase SERVICE-ROLE key must never
# appear here; it bypasses Row Level Security and belongs on the API only.

# API origin. Empty means same-origin '/api'; on Vercel this must be the full
# Render API URL.
VITE_API_BASE_URL=

# --- Supabase [R2] ---
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Cloudinary (direct signed uploads) [R4] ---
VITE_CLOUDINARY_CLOUD_NAME=

# --- Observability [R4] ---
VITE_SENTRY_DSN=
