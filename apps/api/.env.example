# =============================================
# EM Furniture & Interior — API Environment
# =============================================
#
# Copy to .env and fill in. .env and .env.* are gitignored; this file is the
# only one tracked, so never put a real value in it.
#
# Variables marked [R2] and [R3] belong to the replatform phases in
# context/06-replatform-plan.md and are unused until those land. Filling them
# in early is harmless.

# --- App ---
NODE_ENV=development
PORT=5000

# Both client origins. FRONTEND_URL is the legacy single-origin name, still read
# by the payment callbacks; STOREFRONT_URL and ERP_URL replace it once the apps
# are deployed separately and CORS needs both.
FRONTEND_URL=http://localhost:5173
STOREFRONT_URL=http://localhost:5173
ERP_URL=http://localhost:5174

# --- Database: MongoDB (current) ---
MONGODB_URI=mongodb://localhost:27017/em_furniture

# --- Database: PostgreSQL / Supabase [R3] ---
# Two connection strings, and the distinction matters. The pooler (port 6543,
# transaction mode) is what the running application uses. Migrations MUST use
# the direct connection (port 5432) — advisory locks and DDL need session state
# that transaction-mode pooling does not provide.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Auth: JWT (current) ---
JWT_SECRET=change_me_to_a_strong_random_string

# --- Auth: Supabase [R2] ---
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security entirely. It belongs on
# the API host only — never in a Vercel project, never in anything VITE_-prefixed,
# never in a client bundle.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# --- Cloudinary (image hosting) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Gmail OAuth2 (email sending) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=
EMAIL_USER=emfurnitureandinterior@gmail.com

# --- Payment gateways ---
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=NGN

# --- Payment webhooks (REQUIRED in production) ---
# Without these the webhook endpoints return 500 and payment confirmation falls
# back to the browser callback, which loses any payment where the customer does
# not return to the site.
#
# Paystack   reuses PAYSTACK_SECRET_KEY to sign; register the endpoint at
#            Dashboard > Settings > API Keys & Webhooks:
#              https://<api-host>/api/payments/webhooks/paystack
# Stripe     signing secret (whsec_...) shown when you add the endpoint:
#              https://<api-host>/api/payments/webhooks/stripe
#            Subscribe to: checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# --- Pricing (server-authoritative) ---
# The server derives every money figure on an order from catalog prices and
# these values. Nothing about pricing is taken from the request body.
TAX_RATE_PERCENTAGE=7.5
# Flat shipping charge applied to every order. 0 = free shipping, which is the
# behaviour the checkout page has always shown.
SHIPPING_FLAT_RATE=0

# --- Observability [R4] ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
LOG_LEVEL=info

# --- Backups [R4] ---
# 256-bit hex. Held OUTSIDE Supabase and Render — a key stored only in the
# environment of the service being backed up protects against nothing. Two named
# holders, in a password manager. See docs/BACKUP_RUNBOOK.md.
BACKUP_ENCRYPTION_KEY=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=

# --- Seed (optional) ---
SEED_ADMIN_PASSWORD=ChangeMe123!
