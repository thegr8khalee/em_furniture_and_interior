# =============================================
# EM Furniture & Interior — Backend Environment
# =============================================

# --- App ---
NODE_ENV=development
PORT=5000

# Browser origins allowed to call this API. Both are required in production —
# an unlisted origin is refused, not reflected. No trailing slash.
STOREFRONT_URL=http://localhost:5173
ERP_URL=http://localhost:5174

# Legacy single-app deploys. Still read by the payment callback URLs, so keep it
# pointing at the storefront.
FRONTEND_URL=http://localhost:5173

# --- Database (PostgreSQL / Supabase) ---
# Two connection strings, deliberately. The app runs through Supabase's
# transaction-mode pooler (port 6543); migrations must use the direct
# connection (5432), because transaction pooling provides no session state and
# advisory locks silently do nothing there. Conflating them fails halfway
# through a schema change.
DATABASE_URL=postgres://postgres@localhost:5432/em_dev
DIRECT_DATABASE_URL=postgres://postgres@localhost:5432/em_dev
DB_POOL_MAX=10

# Where the schema tests create their throwaway databases.
TEST_DATABASE_URL=postgres://postgres@localhost:5432/postgres


# --- Logging ---
# Structured JSON in production; pretty-printed locally. Set LOG_FORMAT=json to
# get JSON in development too (and to avoid needing the pino-pretty devDependency).
LOG_LEVEL=debug
LOG_FORMAT=pretty

# --- Auth ---
JWT_SECRET=change_me_to_a_strong_random_string

# --- Cloudinary (image hosting) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Gmail OAuth2 (email sending) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://developers.google.com/oauthplayground
GOOGLE_REFRESH_TOKEN=
EMAIL_USER=emfurnitureandinterior@gmail.com

# --- Payments (Paystack only) ---
# Also the HMAC key Paystack signs webhooks with, so this is required in
# production even if you never call the API directly.
# Webhook URL to register in the Paystack dashboard:
#   https://<your-api-host>/api/payments/paystack/webhook
PAYSTACK_SECRET_KEY=

# --- Tax ---
TAX_RATE_PERCENTAGE=7.5

# --- Seed (optional) ---
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- First console account ---
# `npm run bootstrap:staff` reads these. A fresh database has no operator, and
# POST /api/admin/signup requires one, so this is how the first account is made.
# The password is read from here rather than a command-line argument, which
# would end up in shell history and in `ps`. Minimum 12 characters.
BOOTSTRAP_STAFF_EMAIL=
BOOTSTRAP_STAFF_PASSWORD=
BOOTSTRAP_STAFF_USERNAME=Owner
